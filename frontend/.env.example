# Backend API URL (used by server actions and server components)
API_BASE_URL=

# E2E test credentials — must match an existing user in the dev database
E2E_TEST_EMAIL=
E2E_TEST_PASSWORD=
E2E_TEST_RESET_SECRET=

# Playwright — override the app base URL when running e2e tests against a non-local server
# BASE_URL=http://localhost:3000

NODE_ENV=local # LOV local, production, for now.

# Optional: pre-fills the login email when running locally (npm run dev only)
NEXT_PUBLIC_DEV_LOGIN_EMAIL=
