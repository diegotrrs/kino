    "@storybook/react": "^7.4.5",
    "@storybook/testing-library": "^0.2.1",
    "@tailwindcss/forms": "^0.5.3",
    "@types/node": "20.6.3",
    "@types/react": "18.2.22",
    "@types/react-dom": "18.2.7",
    "@types/react-flatpickr": "^3.8.8",
    "autoprefixer": "^10.4.14",
    "eslint-plugin-storybook": "^0.6.14",
    "postcss": "^8.4.24",
    "storybook": "^7.4.5",
    "tailwindcss": "^3.3.2"
  }
